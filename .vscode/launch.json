
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PrestServ - Debug Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.headless=true",
                "--server.port=8501",
                "--server.runOnSave=true",
                "--server.fileWatcherType=auto"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        }
    ]
}
